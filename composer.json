{
    "name": "salesfire/magento2",
    "description": "Salesfire Magento2",
    "type": "magento2-module",
    "version": "1.5.22",
    "license": [
        "OSL-3.0"
    ],
    "authors": [
        {
            "name": "Salesfire",
            "email": "hello@salesfire.co.uk",
            "homepage": "https://www.salesfire.co.uk",
            "role": "Company"
        }
    ],
    "require": {
        "salesfire/salesfire": "^1.1.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Salesfire\\Salesfire\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
